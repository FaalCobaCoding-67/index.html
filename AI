<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuizAI Assistant - Companion Mode</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        :root {
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --card-border: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-green: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            padding-bottom: 80px;
        }

        /* Top Bar Navigation */
        .top-bar {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--card-border);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-badge {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 0.5px;
        }

        .api-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #ef4444;
        }

        .status-dot.active {
            background-color: var(--accent-green);
        }

        /* Main Workspace Container */
        .main-container {
            max-width: 900px;
            margin: 20px auto;
            width: 90%;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Controls & Inputs */
        input[type="text"], input[type="password"], textarea {
            width: 100%;
            background: #0f172a;
            border: 1px solid var(--card-border);
            border-radius: 10px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }

        input:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
        }

        .btn {
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            background: #334155;
        }

        /* FLOATING OVERLAY WIDGET STYLES */
        #quizWidget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 350px;
            max-width: 90vw;
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            z-index: 9999;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .widget-header {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: move;
            user-select: none;
        }

        .widget-title {
            font-weight: 700;
            font-size: 13px;
        }

        .widget-controls {
            display: flex;
            gap: 6px;
        }

        .widget-btn {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            width: 26px;
            height: 26px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .widget-body {
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 480px;
            overflow-y: auto;
        }

        .widget-body.minimized {
            display: none;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .action-btn {
            padding: 8px 10px;
            font-size: 12px;
            border-radius: 8px;
        }

        /* Result Display Area */
        .result-box {
            background: #0f172a;
            border: 1px solid var(--card-border);
            border-radius: 10px;
            padding: 12px;
            font-size: 13px;
            line-height: 1.5;
            min-height: 80px;
            max-height: 200px;
            overflow-y: auto;
        }

        .image-preview-container {
            display: none;
            position: relative;
        }

        .image-preview-container img {
            max-width: 100%;
            max-height: 100px;
            border-radius: 8px;
        }

        .remove-img-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            background: rgba(0,0,0,0.7);
            color: white;
            border: none;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <div class="top-bar">
        <div class="logo-group">
            <span class="logo-badge">QUIZ AI</span>
            <span style="font-size: 14px; font-weight: 600;">Assistant</span>
        </div>
        <div class="api-status">
            <div id="statusDot" class="status-dot"></div>
            <span id="statusText">API Belum Terhubung</span>
        </div>
    </div>

    <!-- Main Workspace Container -->
    <div class="main-container">
        
        <!-- API Setup Card -->
        <div class="card">
            <div class="section-title">
                🔑 Pengaturan Gemini API Key
            </div>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 12px;">
                Masukkan Gemini API Key Anda untuk mengaktifkan AI pemroses soal.
            </p>
            <div style="display: flex; gap: 10px;">
                <input type="password" id="apiKeyInput" placeholder="Masukkan Gemini API Key...">
                <button class="btn" onclick="saveApiKey()">Simpan</button>
            </div>
        </div>

    </div>

    <!-- FLOATING WIDGET OVERLAY -->
    <div id="quizWidget">
        <div class="widget-header" id="widgetHeader">
            <div class="widget-title">
                ⚡ QuizAI Overlay
            </div>
            <div class="widget-controls">
                <button class="widget-btn" onclick="openPictureInPicture()" title="Melayang di Luar Browser">↗️</button>
                <button class="widget-btn" onclick="toggleMinimize()" id="minBtn" title="Kecilkan / Perbesar">—</button>
            </div>
        </div>

        <div class="widget-body" id="widgetBody">
            <div class="quick-actions">
                <button class="btn action-btn" onclick="pasteAndSolve()">
                    ⚡ Tempel & Jawab
                </button>
                <button class="btn btn-secondary action-btn" onclick="document.getElementById('imageInput').click()">
                    📷 Foto Soal
                </button>
            </div>

            <input type="file" id="imageInput" accept="image/*" style="display: none;" onchange="handleImageUpload(event)">

            <div id="imagePreviewContainer" class="image-preview-container">
                <img id="imagePreview" src="" alt="Soal Image">
                <button class="remove-img-btn" onclick="removeImage()">✕</button>
            </div>

            <textarea id="questionInput" rows="3" placeholder="Ketik atau tempel soal kuis di sini..."></textarea>

            <button class="btn" style="width: 100%;" id="solveBtn" onclick="processQuizAI()">
                Analisis & Jawab Soal
            </button>

            <div class="section-title" style="font-size: 12px; margin-bottom: 0; margin-top: 5px;">
                💡 Jawaban AI:
            </div>
            <div class="result-box" id="resultOutput">
                <em>Hasil jawaban akan muncul di sini...</em>
            </div>

            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <button class="btn btn-secondary action-btn" style="padding: 4px 8px; font-size: 11px;" onclick="speakResult()">
                    🔊 Suara
                </button>
                <button class="btn btn-secondary action-btn" style="padding: 4px 8px; font-size: 11px;" onclick="clearAll()">
                    🗑️ Hapus
                </button>
            </div>
        </div>
    </div>

    <script>
        let geminiApiKey = localStorage.getItem('GEMINI_API_KEY') || '';
        let currentBase64Image = null;
        let isMinimized = false;

        window.onload = function() {
            if (geminiApiKey) {
                document.getElementById('apiKeyInput').value = geminiApiKey;
                updateStatus(true);
            }
            makeElementDraggable(document.getElementById('quizWidget'));
        };

        function saveApiKey() {
            const key = document.getElementById('apiKeyInput').value.trim();
            if (key) {
                localStorage.setItem('GEMINI_API_KEY', key);
                geminiApiKey = key;
                updateStatus(true);
                alert('API Key disimpan!');
            } else {
                localStorage.removeItem('GEMINI_API_KEY');
                geminiApiKey = '';
                updateStatus(false);
                alert('API Key dihapus.');
            }
        }

        function updateStatus(active) {
            const dot = document.getElementById('statusDot');
            const text = document.getElementById('statusText');
            if (active) {
                dot.classList.add('active');
                text.innerText = 'API Terhubung';
            } else {
                dot.classList.remove('active');
                text.innerText = 'API Belum Terhubung';
            }
        }

        function toggleMinimize() {
            const body = document.getElementById('widgetBody');
            const minBtn = document.getElementById('minBtn');
            isMinimized = !isMinimized;
            if (isMinimized) {
                body.classList.add('minimized');
                minBtn.innerText = '▢';
            } else {
                body.classList.remove('minimized');
                minBtn.innerText = '—';
            }
        }

        function makeElementDraggable(element) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            const header = document.getElementById('widgetHeader');
            if (header) header.onmousedown = dragMouseDown;

            function dragMouseDown(e) {
                if (e.target.tagName === 'BUTTON') return;
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
            }

            function elementDrag(e) {
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                element.style.top = (element.offsetTop - pos2) + "px";
                element.style.left = (element.offsetLeft - pos1) + "px";
                element.style.bottom = "auto";
                element.style.right = "auto";
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
            }
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentBase64Image = e.target.result.split(',')[1];
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewContainer').style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            currentBase64Image = null;
            document.getElementById('imageInput').value = '';
            document.getElementById('imagePreviewContainer').style.display = 'none';
        }

        async function pasteAndSolve() {
            try {
                const text = await navigator.clipboard.readText();
                if (text) {
                    document.getElementById('questionInput').value = text;
                    processQuizAI();
                } else {
                    alert('Clipboard kosong.');
                }
            } catch (err) {
                alert('Silakan tempel teks soal secara manual.');
            }
        }

        async function processQuizAI() {
            if (!geminiApiKey) {
                alert('Silakan masukkan Gemini API Key terlebih dahulu!');
                return;
            }

            const questionText = document.getElementById('questionInput').value.trim();
            const outputBox = document.getElementById('resultOutput');
            const solveBtn = document.getElementById('solveBtn');

            if (!questionText && !currentBase64Image) {
                alert('Masukkan soal teks atau foto soal.');
                return;
            }

            solveBtn.innerText = '⏳ Menganalisis...';
            solveBtn.disabled = true;
            outputBox.innerHTML = '<em>AI sedang menganalisis...</em>';

            const systemPrompt = "Anda adalah AI kuis. Jawab dengan sangat singkat. Format:\n1. Baris 1: **JAWABAN: [Opsi/Jawaban]**\n2. Baris 2: **Penjelasan Singkat:** (maks 2 kalimat).";

            let parts = [];
            if (questionText) parts.push({ text: questionText });
            if (currentBase64Image) {
                parts.push({ inline_data: { mime_type: "image/jpeg", data: currentBase64Image } });
            }

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${geminiApiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        system_instruction: { parts: [{ text: systemPrompt }] },
                        contents: [{ parts: parts }]
                    })
                });

                const data = await response.json();
                if (data.candidates && data.candidates[0].content.parts[0].text) {
                    outputBox.innerHTML = marked.parse(data.candidates[0].content.parts[0].text);
                } else {
                    outputBox.innerHTML = '<b>Gagal memproses. Cek API Key Anda.</b>';
                }
            } catch (error) {
                outputBox.innerHTML = `<b>Error: ${error.message}</b>`;
            } finally {
                solveBtn.innerText = 'Analisis & Jawab Soal';
                solveBtn.disabled = false;
            }
        }

        function speakResult() {
            const text = document.getElementById('resultOutput').innerText;
            if (!text) return;
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'id-ID';
            window.speechSynthesis.speak(utterance);
        }

        function clearAll() {
            document.getElementById('questionInput').value = '';
            document.getElementById('resultOutput').innerHTML = '<em>Hasil jawaban akan muncul di sini...</em>';
            removeImage();
        }

        async function openPictureInPicture() {
            if ('documentPictureInPicture' in window) {
                try {
                    const pipWindow = await window.documentPictureInPicture.requestWindow({ width: 360, height: 500 });
                    const widgetElement = document.getElementById('quizWidget').cloneNode(true);
                    pipWindow.document.body.appendChild(widgetElement);
                } catch (err) {
                    alert("Fitur tidak dapat dibuka.");
                }
            } else {
                alert("Browser tidak mendukung Document Picture-in-Picture.");
            }
        }
    </script>
</body>
</html>
